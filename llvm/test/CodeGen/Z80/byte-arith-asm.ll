; Show the entire packing, arithmetic, and result-extension sequences rather
; than checking only that an MLT or a helper call occurs.

define i24 @byte_product(i8 %a, i8 %b) {
; OPT-LABEL: byte_product:
; OPT:       ; %bb.0:
; OPT-NEXT:    ld iy, 0
; OPT-NEXT:    add iy, sp
; OPT-NEXT:    ld a, (iy + 3)
; OPT-NEXT:    ld e, (iy + 6)
; OPT-NEXT:    ld bc, 0
; OPT-NEXT:    push bc
; OPT-NEXT:    pop hl
; OPT-NEXT:    ld l, a
; OPT-NEXT:    ld c, e
; OPT-NEXT:    call __imulu
; OPT-NEXT:    ret
  %x = zext i8 %a to i24
  %y = zext i8 %b to i24
  %r = mul i24 %x, %y
  ret i24 %r
}

