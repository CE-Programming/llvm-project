; Keep complete caller/callee assembly for merged-module ABI conversion.
; The public entry keeps its stack ABI. The private callee needs both register
; arguments and a stack tail, and a frame that preserves incoming registers.
@escaped_frame = external global ptr

define internal i24 @private_with_frame(i24 %a, i24 %b, i24 %c, i24 %d) noinline {
; REG-LABEL: private_with_frame:
; REG:       ; %bb.0:
; REG-NEXT:    push ix
; REG-NEXT:    ld ix, 0
; REG-NEXT:    add ix, sp
; REG-NEXT:    lea iy, ix - 24
; REG-NEXT:    ld sp, iy
; REG-NEXT:    push bc
; REG-NEXT:    pop iy
; REG-NEXT:    lea bc, ix - 24
; REG-NEXT:    ld (_escaped_frame), bc
; REG-NEXT:    add hl, de
; REG-NEXT:    ld de, (ix + 6)
; REG-NEXT:    add iy, de
; REG-NEXT:    lea de, iy + 0
; REG-NEXT:    add hl, de
; REG-NEXT:    ld sp, ix
; REG-NEXT:    pop ix
; REG-NEXT:    ret
;
; STACK-LABEL: private_with_frame:
; STACK:       ; %bb.0:
; STACK-NEXT:    push ix
; STACK-NEXT:    ld ix, 0
; STACK-NEXT:    add ix, sp
; STACK-NEXT:    lea hl, ix - 24
; STACK-NEXT:    ld sp, hl
; STACK-NEXT:    ld hl, (ix + 6)
; STACK-NEXT:    ld bc, (ix + 9)
; STACK-NEXT:    ld iy, (ix + 12)
; STACK-NEXT:    lea de, ix - 24
; STACK-NEXT:    ld (_escaped_frame), de
; STACK-NEXT:    add hl, bc
; STACK-NEXT:    ld de, (ix + 15)
; STACK-NEXT:    add iy, de
; STACK-NEXT:    lea de, iy + 0
; STACK-NEXT:    add hl, de
; STACK-NEXT:    ld sp, ix
; STACK-NEXT:    pop ix
; STACK-NEXT:    ret
  %frame = alloca [24 x i8], align 1
  store volatile ptr %frame, ptr @escaped_frame, align 1
  %ab = add i24 %a, %b
  %cd = add i24 %c, %d
  %r = add i24 %ab, %cd
  ret i24 %r
}

