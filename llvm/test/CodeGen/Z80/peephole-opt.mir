name: stack_copy_volatile
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_volatile
# CHECK: PUSH24r
# CHECK-NEXT: $ude = POP24r
body: |
  bb.0:
    liveins: $uhl
    PUSH24r $uhl, implicit-def $spl, implicit $spl :: (volatile store (s24))
    $ude = POP24r implicit-def $spl, implicit $spl
    RET24 implicit $ude, implicit-def $spl, implicit $spl
...
---
name: rlc_carry
tracksRegLiveness: true
# CHECK-LABEL: name: rlc_carry
# CHECK: RLCA
# CHECK-NOT: RLC8g
# CHECK: SBC8ar
body: |
  bb.0:
    liveins: $a
    $a = RLC8g $a, implicit-def $f
    SBC8ar $a, implicit-def $a, implicit-def $f, implicit $a, implicit $f
    RET24 implicit $a, implicit $f, implicit-def $spl, implicit $spl
...
