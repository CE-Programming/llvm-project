# NOTE: Do not autogenerate
# RUN: llc -mtriple=ez80 -run-pass=z80-machine-peephole-opt -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=ez80 -run-pass=z80-machine-peephole-opt -z80-enable-machine-peephole-opt=false -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=OFF

---
name: lea_inc
tracksRegLiveness: true
# CHECK-LABEL: name: lea_inc
# CHECK: $uhl = LEA24ro $uix, 31
# CHECK-NOT: INC24r
body: |
  bb.0:
    liveins: $uix
    $uhl = LEA24ro $uix, 30
    $uhl = INC24r $uhl
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...
# OFF-LABEL: name: lea_inc
# OFF: $uhl = LEA24ro $uix, 30
# OFF-NEXT: $uhl = INC24r $uhl
---
name: lea_dec
tracksRegLiveness: true
# CHECK-LABEL: name: lea_dec
# CHECK: $uhl = LEA24ro $uix, -128
# CHECK-NOT: DEC24r
body: |
  bb.0:
    liveins: $uix
    $uhl = LEA24ro $uix, -127
    $uhl = DEC24r $uhl
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...
