name: sign_extend
tracksRegLiveness: true
# CHECK-LABEL: name: sign_extend
# CHECK: RLCA
# CHECK-NEXT: RRCA
# CHECK-NEXT: SBC24aa
# CHECK-NOT: LD8gg
body: |
  bb.0:
    liveins: $a
    $l = LD8gg $a
    $l = RLC8g $l, implicit-def $f
    SBC24aa implicit-def $uhl, implicit-def $f, implicit undef $uhl, implicit $f
    RET24 implicit $uhl, implicit $a, implicit $f, implicit-def $spl, implicit $spl
...
---
name: sign_extend_wrong_source
tracksRegLiveness: true
# CHECK-LABEL: name: sign_extend_wrong_source
# CHECK: $l = LD8gg $b
# CHECK-NEXT: $l = RLC8g $l
# CHECK-NEXT: SBC24aa
body: |
  bb.0:
    liveins: $b
    $l = LD8gg $b
    $l = RLC8g $l, implicit-def $f
    SBC24aa implicit-def $uhl, implicit-def $f, implicit undef $uhl, implicit $f
    RET24 implicit $uhl, implicit $f, implicit-def $spl, implicit $spl
...
---
name: bool_and_bit
tracksRegLiveness: true
# CHECK-LABEL: name: bool_and_bit
# CHECK-NOT: BIT8gb
# CHECK: JQCC
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a, $f
    AND8ai 1, implicit-def $a, implicit-def dead $f, implicit $a
    BIT8gb $a, 0, implicit-def $f
    JQCC %bb.1, 1, implicit $f
    JQ %bb.2
  bb.1:
    liveins: $a
    RET24 implicit $a, implicit-def $spl, implicit $spl
  bb.2:
    liveins: $a
    RET24 implicit $a, implicit-def $spl, implicit $spl
...
---
