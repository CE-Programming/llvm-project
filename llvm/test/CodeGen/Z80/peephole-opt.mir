    $uhl = DEC24r $uhl
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...
---
name: lea_other_register
tracksRegLiveness: true
# CHECK-LABEL: name: lea_other_register
# CHECK: $uhl = LEA24ro $uix, 0
# CHECK-NEXT: $ude = INC24r $ude
body: |
  bb.0:
    liveins: $uix, $ude
    $uhl = LEA24ro $uix, 0
    $ude = INC24r $ude
    RET24 implicit $uhl, implicit $ude, implicit-def $spl, implicit $spl
...
---
name: cancel_exchanges
tracksRegLiveness: true
# CHECK-LABEL: name: cancel_exchanges
# CHECK-NOT: EX24DE
# CHECK: RET24
body: |
  bb.0:
    liveins: $uhl, $ude
    EX24DE implicit-def $uhl, implicit-def $ude, implicit $uhl, implicit $ude
    EX24DE implicit-def $uhl, implicit-def $ude, implicit $uhl, implicit $ude
    RET24 implicit $uhl, implicit $ude, implicit-def $spl, implicit $spl
...
---
name: mixed_width_exchanges
tracksRegLiveness: true
# CHECK-LABEL: name: mixed_width_exchanges
# CHECK: EX24DE
# CHECK-NEXT: EX16DE
body: |
  bb.0:
    liveins: $uhl, $ude
    EX24DE implicit-def $uhl, implicit-def $ude, implicit $uhl, implicit $ude
    EX16DE implicit-def $hl, implicit-def $de, implicit $hl, implicit $de
    RET24 implicit $uhl, implicit $ude, implicit-def $spl, implicit $spl
...
---
name: stack_copy_dead_source
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_dead_source
# CHECK-NOT: PUSH24r
# CHECK: EX24DE
# CHECK-NOT: POP24r
body: |
  bb.0:
    liveins: $uhl
    PUSH24r killed $uhl, implicit-def $spl, implicit $spl
    $ude = POP24r implicit-def $spl, implicit $spl
    RET24 implicit $ude, implicit-def $spl, implicit $spl
...
---
name: stack_copy_dead_source_reverse
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_dead_source_reverse
# CHECK-NOT: PUSH24r
# CHECK: EX24DE
# CHECK-NOT: POP24r
body: |
  bb.0:
    liveins: $ude
    PUSH24r killed $ude, implicit-def $spl, implicit $spl
    $uhl = POP24r implicit-def $spl, implicit $spl
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...
---
name: stack_copy_without_kill
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_without_kill
# CHECK: PUSH24r $uhl
# CHECK-NEXT: $ude = POP24r
body: |
  bb.0:
    liveins: $uhl
    PUSH24r $uhl, implicit-def $spl, implicit $spl
    $ude = POP24r implicit-def $spl, implicit $spl
    RET24 implicit $ude, implicit-def $spl, implicit $spl
...
---
# The index-half copy expansion restores DE through HL, but undef operands
# hide that dependency from backwards liveness. The original copy did not
# kill DE, so it must not turn into an exchange that overwrites DE.
name: stack_copy_exchange_carrier
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_exchange_carrier
# CHECK: PUSH24r $ude
# CHECK-NEXT: $uhl = POP24r
# CHECK-NEXT: EX24DE
# CHECK-NEXT: $e = LD8yy $iyl
# CHECK-NEXT: $d = LD8yy $iyh
# CHECK-NEXT: EX24DE
body: |
  bb.0:
    liveins: $ude, $uhl, $uiy
    PUSH24r $ude, implicit-def $spl, implicit $spl
    $uhl = POP24r implicit-def $spl, implicit $spl
    EX24DE implicit-def $ude, implicit-def $uhl, implicit undef $ude, implicit undef $uhl
    $e = LD8yy $iyl
    $d = LD8yy $iyh
    EX24DE implicit-def $ude, implicit-def $uhl, implicit $ude, implicit undef $uhl, implicit $uhl, implicit-def $uhl
    RET24 implicit $ude, implicit $uhl, implicit-def $spl, implicit $spl
...
