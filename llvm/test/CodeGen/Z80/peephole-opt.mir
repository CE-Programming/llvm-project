---
name: stack_copy_successor_live
tracksRegLiveness: true
# CHECK-LABEL: name: stack_copy_successor_live
# CHECK: PUSH24r $uhl
# CHECK-NEXT: $ude = POP24r
body: |
  bb.0:
    successors: %bb.1
    liveins: $uhl
    PUSH24r $uhl, implicit-def $spl, implicit $spl
    $ude = POP24r implicit-def $spl, implicit $spl
    JQ %bb.1
  bb.1:
    liveins: $uhl, $ude
    RET24 implicit $uhl, implicit $ude, implicit-def $spl, implicit $spl
...
