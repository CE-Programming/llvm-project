# RUN: llc -mtriple=ez80 -run-pass=z80-postlegalizer-combiner -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define void @copy_prop() { ret void }
  define void @copy_rematerializable() { ret void }
  define void @sink_constant() { ret void }
  define void @extend_load() { ret void }
  define void @extend_stack_two() { ret void }
  define void @extend_stack_shared() { ret void }
  define void @fold_select() { ret void }
  define void @fold_ptr_add() { ret void }
...

---
# CHECK-LABEL: name:            copy_prop
# CHECK-NOT:   %3:_(s24) = COPY
# CHECK:       %2:_(s24) = G_ADD %0, %1
# CHECK-NEXT:  %4:_(s24) = G_ADD %2, %2
name: copy_prop
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(s24) = G_IMPLICIT_DEF
    %1:_(s24) = G_IMPLICIT_DEF
    %2:_(s24) = G_ADD %0, %1
    %3:_(s24) = COPY %2
    %4:_(s24) = G_ADD %3, %3
    $uhl = COPY %4
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            copy_rematerializable
# CHECK:       %0:_(s24) = G_CONSTANT i24 7
# CHECK-NEXT:  %1:_(s24) = COPY %0(s24)
name: copy_rematerializable
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(s24) = G_CONSTANT i24 7
    %1:_(s24) = COPY %0
    %2:_(s24) = G_ADD %1, %1
    $uhl = COPY %2
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            sink_constant
# CHECK:       bb.0:
# CHECK-NOT:   G_CONSTANT
# CHECK:       G_BR %bb.1
# CHECK:       bb.1:
# CHECK-NEXT:  %1:_(s24) = G_CONSTANT i24 7
# CHECK-NEXT:  %2:_(s24) = G_ADD %0, %1
name: sink_constant
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    %0:_(s24) = G_IMPLICIT_DEF
    %1:_(s24) = G_CONSTANT i24 7
    G_BR %bb.1

  bb.1:
    %2:_(s24) = G_ADD %0, %1
    $uhl = COPY %2
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            extend_load
# CHECK-NOT:   G_ANYEXT
# CHECK:       %2:_(s24) = G_LOAD %0(p0) :: (load (s8))
# CHECK-NEXT:  %4:_(s8) = G_TRUNC %2(s24)
name: extend_load
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(p0) = G_IMPLICIT_DEF
    %1:_(s8) = G_LOAD %0 :: (load (s8))
    %2:_(s24) = G_ANYEXT %1
    G_STORE %1, %0 :: (store (s8))
    %3:_(s24) = G_ADD %2, %2
    $uhl = COPY %3
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# A two-user stack load would only trade the extend for a truncate while
# lengthening the 24-bit live range.
# CHECK-LABEL: name:            extend_stack_two
# CHECK:       %1:_(s16) = G_LOAD %0(p0) :: (invariant load (s16) from %fixed-stack.0, align 1)
# CHECK-NEXT:  %2:_(s24) = G_ANYEXT %1(s16)
name: extend_stack_two
legalized: true
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 0, size: 2, alignment: 1, isImmutable: true }
body: |
  bb.0:
    %0:_(p0) = G_FRAME_INDEX %fixed-stack.0
    %1:_(s16) = G_LOAD %0 :: (invariant load (s16) from %fixed-stack.0, align 1)
    %2:_(s24) = G_ANYEXT %1
    %3:_(s16) = G_ADD %1, %1
    %4:_(p0) = G_IMPLICIT_DEF
    G_STORE %3, %4 :: (store (s16))
    $uhl = COPY %2
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            extend_stack_shared
# CHECK-NOT:   G_ANYEXT
# CHECK:       %2:_(s24) = G_LOAD %0(p0) :: (invariant load (s16) from %fixed-stack.0, align 1)
# CHECK-NEXT:  %6:_(s16) = G_TRUNC %2(s24)
name: extend_stack_shared
legalized: true
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 0, size: 2, alignment: 1, isImmutable: true }
body: |
  bb.0:
    %0:_(p0) = G_FRAME_INDEX %fixed-stack.0
    %1:_(s16) = G_LOAD %0 :: (invariant load (s16) from %fixed-stack.0, align 1)
    %2:_(s24) = G_ANYEXT %1
    %3:_(s16) = G_ADD %1, %1
    %4:_(s16) = G_SUB %1, %1
    %5:_(p0) = G_IMPLICIT_DEF
    G_STORE %3, %5 :: (store (s16))
    G_STORE %4, %5 :: (store (s16))
    $uhl = COPY %2
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            fold_select
# CHECK-NOT:   G_SELECT
# CHECK:       %5:_(s24) = G_SEXT %0(s1)
# CHECK-NEXT:  %2:_(s24) = G_CONSTANT i24 1
# CHECK-NEXT:  %3:_(s24) = G_OR %5, %2
name: fold_select
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(s1) = G_IMPLICIT_DEF
    %1:_(s24) = G_CONSTANT i24 -1
    %2:_(s24) = G_CONSTANT i24 1
    %3:_(s24) = G_SELECT %0, %1, %2
    %4:_(s24) = G_ADD %3, %3
    $uhl = COPY %4
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
# CHECK-LABEL: name:            fold_ptr_add
# CHECK-NOT:   G_CONSTANT i24 3
# CHECK-NOT:   G_CONSTANT i24 5
# CHECK:       %6:_(s24) = G_CONSTANT i24 8
# CHECK-NEXT:  %4:_(p0) = G_PTR_ADD %0, %6(s24)
name: fold_ptr_add
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    %0:_(p0) = G_IMPLICIT_DEF
    %1:_(s24) = G_CONSTANT i24 3
    %2:_(p0) = G_PTR_ADD %0, %1
    %3:_(s24) = G_CONSTANT i24 5
    %4:_(p0) = G_PTR_ADD %2, %3
    %5:_(s8) = G_LOAD %4 :: (load (s8))
    $a = COPY %5
    RET24 implicit $a, implicit-def $spl, implicit $spl
...
