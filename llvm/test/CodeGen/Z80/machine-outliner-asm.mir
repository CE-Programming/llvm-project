# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=ez80 -start-before=postrapseudos -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=OPT

# Raising the minimum sequence size leaves the same candidate bodies inline.
# In the default run all four live-out pairs and the flags must survive the
# outlined call and final target passes. Detailed helper checks also live in
# machine-outliner.mir and machine-outliner-{byte-,}liveout.mir.
--- |
  define i24 @outlined_first() minsize nounwind {
  ; OPT-LABEL: outlined_first:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    ld hl, 1193046
  ; OPT-NEXT:    ld de, 6636321
  ; OPT-NEXT:    ld bc, 344865
  ; OPT-NEXT:    ld iy, 4548489
  ; OPT-NEXT:    add hl, de
  ; OPT-NEXT:    ld c, 17
  ; OPT-NEXT:    ret
    ret i24 0
  }
  define i24 @outlined_second() minsize nounwind {
  ; OPT-LABEL: outlined_second:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    ld hl, 1193046
  ; OPT-NEXT:    ld de, 6636321
  ; OPT-NEXT:    ld bc, 344865
  ; OPT-NEXT:    ld iy, 4548489
  ; OPT-NEXT:    add hl, de
  ; OPT-NEXT:    ld c, 17
  ; OPT-NEXT:    ret
    ret i24 0
  }
...

---
name: outlined_first
tracksRegLiveness: true
body: |
  bb.0:
    $uhl = LD24ri 1193046
    $ude = LD24ri 6636321
    $ubc = LD24ri 344865
    $uiy = LD24ri 4548489
    $uhl = ADD24ao $uhl, $ude, implicit-def $f
    $c = LD8ri 17
    RET24 implicit $uhl, implicit $ude, implicit $ubc, implicit $uiy, implicit $f, implicit-def $spl, implicit $spl
...

---
name: outlined_second
tracksRegLiveness: true
body: |
  bb.0:
    $uhl = LD24ri 1193046
    $ude = LD24ri 6636321
    $ubc = LD24ri 344865
    $uiy = LD24ri 4548489
    $uhl = ADD24ao $uhl, $ude, implicit-def $f
    $c = LD8ri 17
    RET24 implicit $uhl, implicit $ude, implicit $ubc, implicit $uiy, implicit $f, implicit-def $spl, implicit $spl
...
