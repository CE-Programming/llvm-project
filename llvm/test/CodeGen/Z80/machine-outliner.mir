# NOTE: Do not autogenerate
# RUN: llc -mtriple=ez80 -run-pass=machine-outliner -z80-machine-outliner-min-sequence-bytes=11 -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=ez80 -start-before=machine-outliner -z80-machine-outliner-min-sequence-bytes=11 -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=ASM
# RUN: llc -mtriple=ez80-code16 -run-pass=machine-outliner -z80-machine-outliner-min-sequence-bytes=11 -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=TOO-SHORT
# RUN: llc -mtriple=ez80 -run-pass=machine-outliner -z80-machine-outliner-min-sequence-bytes=12 -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=TOO-SHORT

--- |
  declare void @helper()
  define void @first() minsize nounwind { ret void }
  define void @second() minsize nounwind { ret void }
  define void @stack_first() minsize nounwind { ret void }
  define void @stack_second() minsize nounwind { ret void }
  define void @frame_first() minsize nounwind { ret void }
  define void @frame_second() minsize nounwind { ret void }
  define void @section_first() minsize nounwind section "special" { ret void }
  define void @section_second() minsize nounwind section "special" { ret void }
  define void @call0() minsize nounwind { ret void }
  define void @call1() minsize nounwind { ret void }
  define void @refresh0() minsize nounwind { ret void }
  define void @refresh1() minsize nounwind { ret void }
  define void @push0() minsize nounwind { ret void }
  define void @push1() minsize nounwind { ret void }
  define void @shadow0() minsize nounwind { ret void }
  define void @shadow1() minsize nounwind { ret void }
  define void @hot0() nounwind { ret void }
  define void @hot1() nounwind { ret void }
  define void @excluded0() minsize nounwind "nooutline" { ret void }
  define void @excluded1() minsize nounwind "nooutline" { ret void }
  define void @naked0() minsize naked nounwind { ret void }
  define void @naked1() minsize naked nounwind { ret void }
...
---
name: first
tracksRegLiveness: true
# CHECK-LABEL: name: first
# CHECK: CALL24 @OUTLINED_FUNCTION_0, implicit $spl, {{.*}}implicit-def $f
# CHECK-NOT: LD24ri
# TOO-SHORT-LABEL: name: first
# TOO-SHORT-NOT: CALL24
# TOO-SHORT: LD24ri 1193046
body: |
  bb.0:
    liveins: $ude
    $uhl = LD24ri 1193046
    $ude = LD24ri 6636321
    $uhl = ADD24ao $uhl, $ude, implicit-def $f
    $c = LD8ri 17
    RET24 implicit $uhl, implicit $f, implicit-def $spl, implicit $spl
...
---
