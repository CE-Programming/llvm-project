    $ubc = POP24r implicit-def $spl, implicit $spl
    $uhl = ADD24ao $uhl, $ubc, implicit-def $f
    RET24 implicit $uhl, implicit $f, implicit $c, implicit-def $spl, implicit $spl
...
---
name: double24_upper
tracksRegLiveness: true
# CHECK-LABEL: name: double24_upper
# CHECK: PUSH24r
# CHECK: POP24r
# CHECK: ADD24ao
body: |
  bb.0:
    liveins: $uhl, $ubc
    PUSH24r $uhl, implicit-def $spl, implicit $spl
    $ubc = POP24r implicit-def $spl, implicit $spl
    $uhl = ADD24ao $uhl, $ubc, implicit-def $f
    RET24 implicit $uhl, implicit $f, implicit $ubc, implicit-def $spl, implicit $spl
...
---
name: double24_frame
tracksRegLiveness: true
# CHECK-LABEL: name: double24_frame
# CHECK: PUSH24r
# CHECK: POP24r
# CHECK: ADD24ao
body: |
  bb.0:
    liveins: $uhl
    frame-setup PUSH24r $uhl, implicit-def $spl, implicit $spl
    $ubc = POP24r implicit-def $spl, implicit $spl
    $uhl = ADD24ao $uhl, $ubc, implicit-def $f
    RET24 implicit $uhl, implicit $f, implicit-def $spl, implicit $spl
...
---
name: double24_volatile
tracksRegLiveness: true
# CHECK-LABEL: name: double24_volatile
# CHECK: PUSH24r
# CHECK: POP24r
# CHECK: ADD24ao
body: |
  bb.0:
    liveins: $uhl
    PUSH24r $uhl, implicit-def $spl, implicit $spl :: (volatile store (s24))
    $ubc = POP24r implicit-def $spl, implicit $spl
    $uhl = ADD24ao $uhl, $ubc, implicit-def $f
    RET24 implicit $uhl, implicit $f, implicit-def $spl, implicit $spl
...
---
name: byte_bit_dead_a
tracksRegLiveness: true
# CHECK-LABEL: name: byte_bit_dead_a
# CHECK-NOT: LD8gg
# CHECK: $l = RES8gb $l, 0
body: |
  bb.0:
    liveins: $uhl
    $a = LD8gg $l
    $a = RES8gb $a, 0
    $l = LD8gg $a
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...
---
name: byte_bit_live_a
tracksRegLiveness: true
# CHECK-LABEL: name: byte_bit_live_a
# CHECK: $a = LD8gg $l
# CHECK: $a = RES8gb $a, 0
# CHECK: $l = LD8gg $a
body: |
  bb.0:
    liveins: $uhl
    $a = LD8gg $l
    $a = RES8gb $a, 0
    $l = LD8gg $a
    RET24 implicit $uhl, implicit $a, implicit-def $spl, implicit $spl
...
