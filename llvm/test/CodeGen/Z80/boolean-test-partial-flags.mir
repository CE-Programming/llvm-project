# NOTE: Do not autogenerate
# RUN: llc -mtriple=ez80 -run-pass=z80-machine-peephole-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=ez80 -run-pass=z80-machine-late-opt -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @remove_test() { ret void }
  define void @carry_through_inc() { ret void }
...

---
name: remove_test
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $f
    SBC8ar undef $a, implicit-def $a, implicit-def dead $f, implicit undef $a, implicit $f
    OR8ar $a, implicit-def dead $a, implicit-def $f, implicit $a
    JQCC %bb.2, 1, implicit $f

  bb.1:
    RET24 implicit-def $spl, implicit $spl

  bb.2:
    RET24 implicit-def $spl, implicit $spl

# SBC A,A already sets Z for the branch.
# CHECK-LABEL: name: remove_test
# CHECK:      SBC8ar undef $a, implicit-def $a, implicit-def $f
# CHECK-NEXT: JQCC %bb.2, 1
...

---
name: carry_through_inc
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $f, $b
    SBC8ar undef $a, implicit-def $a, implicit-def dead $f, implicit undef $a, implicit $f
    OR8ar $a, implicit-def dead $a, implicit-def $f, implicit $a
    JQCC %bb.2, 1, implicit $f

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $b
    $b = INC8r killed $b, implicit-def $f
    JQCC %bb.3, 3, implicit $f

  bb.2:
    RET24 implicit-def $spl, implicit $spl

  bb.3:
    RET24 implicit-def $spl, implicit $spl

# OR clears the carry that SBC left, and INC passes it on to the carry
# branch, so the test must stay.
# CHECK-LABEL: name: carry_through_inc
# CHECK:      SBC8ar undef $a
# CHECK-NEXT: OR8ar $a
...
