# NOTE: Do not autogenerate
# RUN: llc -mtriple=z80 -run-pass=postrapseudos -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @dead_scratch() !dbg !4 { ret void }
  define void @live_scratch_byte() { ret void }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)
  !1 = !DIFile(filename: "spill.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = !DISubroutineType(types: !{})
  !4 = distinct !DISubprogram(name: "dead_scratch", scope: !1, file: !1, type: !3, unit: !0, spFlags: DISPFlagDefinition)
  !5 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
  !6 = !DILocalVariable(name: "x", scope: !4, type: !5)
  !7 = !DILocation(line: 1, scope: !4)
...

---
name: dead_scratch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix, $iy
    LD88or $ix, -14, $iy
    DBG_VALUE $hl, $noreg, !6, !DIExpression(), debug-location !7
    RET16 implicit-def $sps, implicit $sps

# A debug use alone must leave the exchange's scratch input undef.
# CHECK-LABEL: name: dead_scratch
# CHECK: PUSH16r $iy
# CHECK: $hl = EX16sa undef $hl, implicit $sps
# CHECK-NEXT: LD8og $ix, -14, $l
# CHECK-NEXT: LD8og $ix, -13, $h
# CHECK-NEXT: $hl = POP16r
# CHECK: DBG_VALUE $hl, $noreg
...

---
name: live_scratch_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ix, $iy, $l
    LD88or $ix, -14, $iy
    RET16 implicit-def $sps, implicit $sps, implicit $l

# The exchange saves L across the spill and the pop restores it for the return.
# CHECK-LABEL: name: live_scratch_byte
# CHECK: PUSH16r $iy
# CHECK: $hl = EX16sa $hl, implicit $sps
# CHECK-NEXT: LD8og $ix, -14, $l
# CHECK-NEXT: LD8og $ix, -13, $h
# CHECK-NEXT: $hl = POP16r
...
