; Exercise the IR idiom pass through final assembly, including the zero-trip
; guard. BASELINE retains the loops at the same optimization level.
target triple = "ez80"

define void @copy_bytes(ptr noalias %dst, ptr noalias %src, i24 %n) minsize optsize {
; OPT-LABEL: copy_bytes:
; OPT:       ; %bb.0: ; %entry
; OPT-NEXT:    call __frameset0
; OPT-NEXT:    ld bc, (ix + 6)
; OPT-NEXT:    ld iy, (ix + 9)
; OPT-NEXT:    ld de, (ix + 12)
; OPT-NEXT:    private BB0_1
; OPT-NEXT:  BB0_1: ; %header
; OPT-NEXT:    ; =>This Inner Loop Header: Depth=1
; OPT-NEXT:    sbc hl, hl
; OPT-NEXT:    adc hl, de
; OPT-NEXT:    jr z, BB0_3
; OPT-NEXT:  ; %bb.2: ; %body
; OPT-NEXT:    ; in Loop: Header=BB0_1 Depth=1
; OPT-NEXT:    ld a, (iy)
; OPT-NEXT:    push bc
; OPT-NEXT:    pop hl
; OPT-NEXT:    ld (hl), a
; OPT-NEXT:    inc iy
; OPT-NEXT:    inc hl
; OPT-NEXT:    push hl
; OPT-NEXT:    pop bc
; OPT-NEXT:    dec de
; OPT-NEXT:    jr BB0_1
; OPT-NEXT:    private BB0_3
; OPT-NEXT:  BB0_3: ; %exit
; OPT-NEXT:    pop ix
; OPT-NEXT:    ret
entry:
  br label %header

header:
  %i = phi i24 [ 0, %entry ], [ %next, %body ]
  %more = icmp ult i24 %i, %n
  br i1 %more, label %body, label %exit

body:
  %dp = getelementptr inbounds i8, ptr %dst, i24 %i
  %sp = getelementptr inbounds i8, ptr %src, i24 %i
  %v = load i8, ptr %sp, align 1
  store i8 %v, ptr %dp, align 1
  %next = add i24 %i, 1
  br label %header

exit:
  ret void
}

