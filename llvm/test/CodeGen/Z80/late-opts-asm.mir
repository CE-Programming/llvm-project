# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=ez80 -start-before=z80-machine-address-opt -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=OPT
# RUN: llc -mtriple=ez80 -start-before=z80-machine-address-opt -z80-enable-machine-address-opt=false -z80-enable-machine-peephole-opt=false -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=BASELINE

# Start with identical physical instructions so the assembly comparison isolates
# the final address and peephole passes from selection and register allocation.
--- |
  define i24 @address_chain() {
  ; OPT-LABEL: address_chain:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    lea iy, ix - 25
  ; OPT-NEXT:    ld hl, (iy - 128)
  ; OPT-NEXT:    ret
  ;
  ; BASELINE-LABEL: address_chain:
  ; BASELINE:       ; %bb.0:
  ; BASELINE-NEXT:    lea iy, ix + 0
  ; BASELINE-NEXT:    lea iy, iy - 25
  ; BASELINE-NEXT:    ld hl, (iy - 128)
  ; BASELINE-NEXT:    ret
    ret i24 0
  }
  define i24 @sign_extend_byte() {
  ; OPT-LABEL: sign_extend_byte:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    rlca
  ; OPT-NEXT:    rrca
  ; OPT-NEXT:    sbc hl, hl
  ; OPT-NEXT:    ld l, a
  ; OPT-NEXT:    ret
  ;
  ; BASELINE-LABEL: sign_extend_byte:
  ; BASELINE:       ; %bb.0:
  ; BASELINE-NEXT:    ld l, a
  ; BASELINE-NEXT:    rlc l
  ; BASELINE-NEXT:    sbc hl, hl
  ; BASELINE-NEXT:    ld l, a
  ; BASELINE-NEXT:    ret
    ret i24 0
  }
  define i8 @boolean_branch() {
  ; OPT-LABEL: boolean_branch:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    and a, 1
  ; OPT-NEXT:    jr z, BB2_2
  ; OPT-NEXT:  ; %bb.1:
  ; OPT-NEXT:    ret
  ; OPT-NEXT:    private BB2_2
  ; OPT-NEXT:  BB2_2:
  ; OPT-NEXT:    ld a, 42
  ; OPT-NEXT:    ret
  ;
  ; BASELINE-LABEL: boolean_branch:
  ; BASELINE:       ; %bb.0:
  ; BASELINE-NEXT:    and a, 1
  ; BASELINE-NEXT:    bit 0, a
  ; BASELINE-NEXT:    jr z, BB2_2
  ; BASELINE-NEXT:  ; %bb.1:
  ; BASELINE-NEXT:    ret
  ; BASELINE-NEXT:    private BB2_2
  ; BASELINE-NEXT:  BB2_2:
  ; BASELINE-NEXT:    ld a, 42
  ; BASELINE-NEXT:    ret
    ret i8 0
  }
  define i24 @double_stack_copy() {
  ; OPT-LABEL: double_stack_copy:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    push hl
  ; OPT-NEXT:    pop de
  ; OPT-NEXT:    add hl, de
  ; OPT-NEXT:    ret
  ;
  ; BASELINE-LABEL: double_stack_copy:
  ; BASELINE:       ; %bb.0:
  ; BASELINE-NEXT:    push hl
  ; BASELINE-NEXT:    pop de
  ; BASELINE-NEXT:    add hl, de
  ; BASELINE-NEXT:    ret
    ret i24 0
  }
  define i24 @reset_register_bit() {
  ; OPT-LABEL: reset_register_bit:
  ; OPT:       ; %bb.0:
  ; OPT-NEXT:    ld a, b
  ; OPT-NEXT:    res 0, a
  ; OPT-NEXT:    ld b, a
  ; OPT-NEXT:    ret
  ;
  ; BASELINE-LABEL: reset_register_bit:
  ; BASELINE:       ; %bb.0:
  ; BASELINE-NEXT:    ld a, b
  ; BASELINE-NEXT:    res 0, a
  ; BASELINE-NEXT:    ld b, a
  ; BASELINE-NEXT:    ret
    ret i24 0
  }
...

---
name: address_chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $uix
    $uiy = LEA24ro $uix, 0
    $uiy = LEA24ro killed $uiy, -25
    $uhl = LD24ro killed $uiy, -128
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
name: sign_extend_byte
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    $l = LD8gg $a
    $l = RLC8g $l, implicit-def $f
    SBC24aa implicit-def $uhl, implicit-def $f, implicit undef $uhl, implicit $f
    $l = LD8gg $a
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
name: boolean_branch
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $a
    AND8ai 1, implicit-def $a, implicit-def $f, implicit $a
    BIT8gb $a, 0, implicit-def $f
    JQCC %bb.2, 1, implicit killed $f

  bb.1:
    liveins: $a
    RET24 implicit $a, implicit-def $spl, implicit $spl

  bb.2:
    $a = LD8ri 42
    RET24 implicit $a, implicit-def $spl, implicit $spl
...

---
name: double_stack_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $uhl
    PUSH24r $uhl, implicit-def $spl, implicit $spl
    $ude = POP24r implicit-def $spl, implicit $spl
    $uhl = ADD24ao $uhl, killed $ude, implicit-def $f
    RET24 implicit $uhl, implicit-def $spl, implicit $spl
...

---
name: reset_register_bit
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $ubc
    $a = LD8gg $b
    $a = RES8gb $a, 0
    $b = LD8gg $a
    RET24 implicit $ubc, implicit-def $spl, implicit $spl
...
