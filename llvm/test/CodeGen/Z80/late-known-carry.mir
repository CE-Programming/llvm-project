# NOTE: Do not autogenerate
# RUN: llc -mtriple=z80 -run-pass=z80-machine-late-opt -verify-machineinstrs %s -o - | FileCheck %s

# Each logical instruction clears carry, so the second SCF is needed.

---
name: scf_rcf_scf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    SCF implicit-def dead $f
    RCF implicit-def dead $f
    SCF implicit-def $f
    ADC8ai 0, implicit-def $a, implicit-def dead $f, implicit $a, implicit $f
    RET16 implicit-def $sps, implicit $sps, implicit $a

# CHECK-LABEL: name: scf_rcf_scf
# CHECK:      RCF
# CHECK-NEXT: SCF implicit-def $f
# CHECK-NEXT: ADC8ai 0
...

---
name: scf_or_scf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    SCF implicit-def dead $f
    OR8ar $a, implicit-def $a, implicit-def dead $f, implicit $a
    SCF implicit-def $f
    ADC8ai 0, implicit-def $a, implicit-def dead $f, implicit $a, implicit $f
    RET16 implicit-def $sps, implicit $sps, implicit $a

# CHECK-LABEL: name: scf_or_scf
# CHECK:      OR8ar
# CHECK-NEXT: SCF implicit-def $f
# CHECK-NEXT: ADC8ai 0
...

---
name: scf_and_scf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $b
    SCF implicit-def dead $f
    AND8ar $b, implicit-def $a, implicit-def dead $f, implicit $a
    SCF implicit-def $f
    ADC8ai 0, implicit-def $a, implicit-def dead $f, implicit $a, implicit $f
    RET16 implicit-def $sps, implicit $sps, implicit $a

# CHECK-LABEL: name: scf_and_scf
# CHECK:      AND8ar
# CHECK-NEXT: SCF implicit-def $f
# CHECK-NEXT: ADC8ai 0
...

---
name: scf_xor_scf
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a
    SCF implicit-def dead $f
    XOR8ar $a, implicit-def $a, implicit-def dead $f, implicit $a
    SCF implicit-def $f
    ADC8ai 0, implicit-def $a, implicit-def dead $f, implicit $a, implicit $f
    RET16 implicit-def $sps, implicit $sps, implicit $a

# CHECK-LABEL: name: scf_xor_scf
# CHECK:      XOR8ar
# CHECK-NEXT: SCF implicit-def $f
# CHECK-NEXT: ADC8ar $a
...
