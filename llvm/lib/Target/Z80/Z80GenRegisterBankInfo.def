/// \file
/// This file defines all the static objects used by Z80RegisterBankInfo.
/// \todo This should be generated by TableGen.
//===----------------------------------------------------------------------===//

#ifdef GET_TARGET_REGBANK_INFO_IMPL
RegisterBankInfo::PartialMapping Z80GenRegisterBankInfo::PartMappings[]{
    /* StartIdx, Length, RegBank */
    // GPR value
    {0, 8, Z80::GPRRegBank},   // :0
    {0, 16, Z80::GPRRegBank},  // :1
    {0, 24, Z80::GPRRegBank},  // :2
    // s32 represented as a single value
    {0, 32, Z80::GPRRegBank},  // :3
    {16, 16, Z80::GPRRegBank}, // :4 unused
    // s32 (24 bit mode): represented as a single value
    {0, 32, Z80::GPRRegBank},  // :5
    {24, 8, Z80::GPRRegBank},  // :6 unused
    // s48: represented as a single value
    {0, 48, Z80::GPRRegBank},  // :7
    {24, 24, Z80::GPRRegBank}, // :8 unused
    // s48 (16bit mode): represented as a single value
    {0, 48, Z80::GPRRegBank},  // :9
    {16, 16, Z80::GPRRegBank}, // :10 unused
    {32, 16, Z80::GPRRegBank}, // :11 unused
    // s64 (24bit mode) represented as a single value
    {0, 64, Z80::GPRRegBank},  // :12
    {24, 24, Z80::GPRRegBank}, // :13 unused
    {48, 16, Z80::GPRRegBank}, // :14 unused
    // s64 (16 bit mode) represented as a single value
    {0, 64, Z80::GPRRegBank},  // :15
    {16, 16, Z80::GPRRegBank}, // :16 unused
    {32, 16, Z80::GPRRegBank}, // :17 unused
    {48, 16, Z80::GPRRegBank}, // :18 unused
};
#endif // GET_TARGET_REGBANK_INFO_IMPL

#ifdef GET_TARGET_REGBANK_INFO_CLASS
enum PartialMappingIdx {
  PMI_None = -1,
  PMI_GPR8 = 0,
  PMI_GPR16 = 1,
  PMI_GPR24 = 2,
  PMI_GPR32_16 = 3,
  PMI_GPR32_24 = 5,
  PMI_GPR48_24 = 7,
  PMI_GPR48_16 = 9,
  PMI_GPR64_24 = 12,
  PMI_GPR64_16 = 15,
};
#endif // GET_TARGET_REGBANK_INFO_CLASS

#ifdef GET_TARGET_REGBANK_INFO_IMPL
#define INSTR_3OP(INFO) INFO, INFO, INFO,
#define BREAKDOWN(INDEX, NUM)                                                  \
  { &Z80GenRegisterBankInfo::PartMappings[INDEX], NUM }
// ValueMappings.
RegisterBankInfo::ValueMapping Z80GenRegisterBankInfo::ValMappings[]{
    /* BreakDown, NumBreakDowns */
    // 3-operands instructions (all binary operations should end up with one of
    // those mapping).
    INSTR_3OP(BREAKDOWN(PMI_GPR8, 1))       // 0:  GPR_8
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 3:  GPR_16
    INSTR_3OP(BREAKDOWN(PMI_GPR24, 1))      // 6:  GPR_24
    INSTR_3OP(BREAKDOWN(PMI_GPR32_16, 1))   // 9:  GPR_32 (single)
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 12: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR32_24, 1))   // 15: GPR_32 (single)
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 18: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR48_24, 1))   // 21: GPR_48 (single)
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 24: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR48_16, 1))   // 27: GPR_48 (single)
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 30: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 33: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR64_24, 1))   // 36: GPR_64 (single)
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 39: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR16, 1))      // 42: UNUSED
    INSTR_3OP(BREAKDOWN(PMI_GPR64_16, 1))   // 45: GPR_64 (single)
};
#undef INSTR_3OP
#undef BREAKDOWN
#endif // GET_TARGET_REGBANK_INFO_IMPL

#ifdef GET_TARGET_REGBANK_INFO_CLASS
enum ValueMappingIdx {
  VMI_None = -1,
  VMI_3OpsGpr8Idx =  PMI_GPR8  * 3,
  VMI_3OpsGpr16Idx = PMI_GPR16 * 3,
  VMI_3OpsGpr24Idx = PMI_GPR24 * 3,
};
#undef GET_TARGET_REGBANK_INFO_CLASS
#endif // GET_TARGET_REGBANK_INFO_CLASS

#ifdef GET_TARGET_REGBANK_INFO_IMPL
#undef GET_TARGET_REGBANK_INFO_IMPL
const RegisterBankInfo::ValueMapping *
Z80GenRegisterBankInfo::getValueMapping(PartialMappingIdx Idx,
                                        unsigned NumOperands) {
  // We can use VMI_3Ops Mapping for all the cases.
  if (NumOperands <= 3 && (Idx >= PMI_GPR8 && Idx <= PMI_GPR64_16))
    return &ValMappings[(unsigned)Idx * 3];

  llvm_unreachable("Unsupported PartialMappingIdx.");
}

#endif // GET_TARGET_REGBANK_INFO_IMPL
